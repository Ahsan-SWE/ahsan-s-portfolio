# Public site URL used by canonical URLs, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
INDEXING_ENABLED=false

# Secure CMS publishing. Create a fine-grained GitHub token with Contents: Read and write
# permission for this repository only. Never expose this token with a NEXT_PUBLIC_ prefix.
CMS_GITHUB_TOKEN=github_pat_replace_me
CMS_GITHUB_REPO=Ahsan-SWE/ahsan-s-portfolio
CMS_GITHUB_BRANCH=main

# CMS login. Use a strong password and a separate long random session secret.
ADMIN_PASSWORD=replace_with_a_strong_password
CMS_SESSION_SECRET=replace_with_a_long_random_secret

# Optional contact form email configuration, if used by the project.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
